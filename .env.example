# Root environment example for Docker Compose
# Individual services also load their own env files.

# Frontend
VITE_API_BASE_URL=/api

# API Gateway
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PORT=3000
USER_SERVICE_URL=http://user-service:3001
MOVIE_SERVICE_URL=http://movie-service:3002
BOOKING_SERVICE_URL=http://reservation-service:3003

# User service
USER_SERVICE_PORT=3001
CLIENT_URL=http://localhost:5173
SERVICE_URL=http://localhost:3001
DATABASE=mongodb://mongo:27017/user-service
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken
