NODE_ENV=development
PORT=3001
DATABASE=mongodb://127.0.0.1:27017/user-service

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_MINUTES=10
EMAIL_VERIFICATION_TOKEN_MINUTES=60

CLIENT_URL=http://localhost:3000
SERVICE_URL=http://localhost:3001

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-me
EMAIL_PASSWORD=replace-me

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/users/auth/google/callback
